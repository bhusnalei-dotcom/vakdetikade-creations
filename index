<!-- ====== THREE.JS 3D CANVAS ====== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ============ 3D CONFIGURATOR ============
let scene, camera, renderer, pot, animFrame;
let isDragging = false, prevMouse = {x:0,y:0};
let currentColor = '#C1440E';
let currentShape = 'mug';
let currentFinish = 'Glossy';
let currentSize = 'Medium';
let currentPattern = 'Plain';
let currentEngraving = '';

const priceMap = {mug:{Small:380,Medium:520,Large:680,XL:850}, bowl:{Small:420,Medium:580,Large:780,XL:980}, vase:{Small:650,Medium:950,Large:1300,XL:1600}, plate:{Small:450,Medium:650,Large:850,XL:1100}};
const finishAdd = {Glossy:0,Matte:50,Reactive:120};

function initThree(){
  const canvas = document.getElementById('potCanvas');
  const w = canvas.parentElement.clientWidth;
  const h = w;
  renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
  renderer.setSize(w,h);
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.shadowMap.enabled = true;
  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(45,1,0.1,100);
  camera.position.set(0,1.5,4);
  camera.lookAt(0,0,0);
  const ambient = new THREE.AmbientLight(0xffffff,0.6);
  scene.add(ambient);
  const key = new THREE.DirectionalLight(0xfff5e0,1.2);
  key.position.set(5,8,5);
  key.castShadow = true;
  scene.add(key);
  const fill = new THREE.DirectionalLight(0xe0f0ff,0.4);
  fill.position.set(-5,3,-5);
  scene.add(fill);
  buildPot();
  animate();
  addCanvasInteraction(canvas);
}

function buildPot(){
  if(pot){scene.remove(pot);pot.traverse(c=>{if(c.geometry)c.geometry.dispose();if(c.material)c.material.dispose();});}
  pot = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({
    color: new THREE.Color(currentColor),
    roughness: currentFinish==='Matte'?0.9:currentFinish==='Reactive'?0.5:0.15,
    metalness: currentFinish==='Glossy'?0.05:0
  });

  let geo;
  if(currentShape==='mug'){
    geo = new THREE.CylinderGeometry(0.55,0.45,1.2,32);
    const body = new THREE.Mesh(geo,mat);
    body.position.y = 0.6;
    pot.add(body);
    const rim = new THREE.TorusGeometry(0.55,0.05,12,32);
    const rimM = new THREE.Mesh(rim,mat);
    rimM.position.y = 1.2;
    rimM.rotation.x = Math.PI/2;
    pot.add(rimM);
    const base = new THREE.CylinderGeometry(0.45,0.45,0.08,32);
    const baseM = new THREE.Mesh(base,mat);
    pot.add(baseM);
    // Handle
    const curve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(0.55,1.0,0),
      new THREE.Vector3(1.1,0.8,0),
      new THREE.Vector3(0.55,0.4,0)
    );
    const pts = curve.getPoints(20);
    const handleGeo = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),20,0.08,8,false);
    pot.add(new THREE.Mesh(handleGeo,mat));
  } else if(currentShape==='bowl'){
    const pts = [];
    for(let i=0;i<=16;i++){const a=i/16*(Math.PI/2);pts.push(new THREE.Vector2(Math.sin(a)*0.9,Math.cos(a)*0.5-0.5));}
    geo = new THREE.LatheGeometry(pts,32);
    const body = new THREE.Mesh(geo,mat);
    pot.add(body);
  } else if(currentShape==='vase'){
    const pts = [
      new THREE.Vector2(0.15,0),new THREE.Vector2(0.4,0.3),new THREE.Vector2(0.6,0.7),
      new THREE.Vector2(0.5,1.2),new THREE.Vector2(0.6,1.6),new THREE.Vector2(0.3,1.9),
      new THREE.Vector2(0.2,2.0)
    ];
    geo = new THREE.LatheGeometry(pts,32);
    pot.add(new THREE.Mesh(geo,mat));
  } else if(currentShape==='plate'){
    const pts = [];
    for(let i=0;i<=12;i++){const t=i/12;pts.push(new THREE.Vector2(t*1.1,t<0.8?-0.05:t*0.35-0.3));}
    geo = new THREE.LatheGeometry(pts,48);
    const body = new THREE.Mesh(geo,mat);
    pot.add(body);
    const base2 = new THREE.CylinderGeometry(0.2,0.2,0.05,24);
    const bm = new THREE.Mesh(base2,mat);
    bm.position.y = -0.05;
    pot.add(bm);
  }

  // Speckle pattern approximation
  if(currentPattern==='Speckled'){
    for(let i=0;i<30;i++){
      const sg = new THREE.SphereGeometry(0.025,6,6);
      const sm = new THREE.MeshStandardMaterial({color:0x000000,roughness:0.9});
      const sp = new THREE.Mesh(sg,sm);
      sp.position.set((Math.random()-0.5)*1.2,(Math.random()*1.5),(Math.random()-0.5)*1.2);
      pot.add(sp);
    }
  }

  scene.add(pot);
  updatePrice();
}

function animate(){
  animFrame = requestAnimationFrame(animate);
  if(!isDragging) pot.rotation.y += 0.006;
  renderer.render(scene,camera);
}

function addCanvasInteraction(canvas){
  canvas.addEventListener('mousedown',(e)=>{isDragging=true;prevMouse={x:e.clientX,y:e.clientY};});
  document.addEventListener('mouseup',()=>isDragging=false);
  document.addEventListener('mousemove',(e)=>{
    if(!isDragging)return;
    const dx=e.clientX-prevMouse.x, dy=e.clientY-prevMouse.y;
    pot.rotation.y+=dx*0.01;
    pot.rotation.x+=dy*0.01;
    prevMouse={x:e.clientX,y:e.clientY};
  });
  canvas.addEventListener('wheel',(e)=>{camera.position.z=Math.max(2,Math.min(8,camera.position.z+e.deltaY*0.005));});
  // Touch
  let lt=null;
  canvas.addEventListener('touchstart',(e)=>{isDragging=true;lt={x:e.touches[0].clientX,y:e.touches[0].clientY};});
  canvas.addEventListener('touchend',()=>isDragging=false);
  canvas.addEventListener('touchmove',(e)=>{
    if(!isDragging||!lt)return;
    const dx=e.touches[0].clientX-lt.x, dy=e.touches[0].clientY-lt.y;
    pot.rotation.y+=dx*0.01;pot.rotation.x+=dy*0.01;
    lt={x:e.touches[0].clientX,y:e.touches[0].clientY};
  });
}

function setShape(shape,btn){
  currentShape=shape;
  document.querySelectorAll('#configurator .config-options:first-of-type .opt-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildPot();
}
function setColor(color,el){
  currentColor=color;
  document.querySelectorAll('.swatch').forEach(s=>s.classList.remove('active'));
  el.classList.add('active');
  buildPot();
}
function setFinish(finish,btn){
  currentFinish=finish;
  btn.closest('.config-options').querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildPot();
}
function setSize(size,btn){
  currentSize=size;
  btn.closest('.config-options').querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  updatePrice();
}
function setPattern(pattern,btn){
  currentPattern=pattern;
  btn.closest('.config-options').querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildPot();
}
function updateEngraving(){currentEngraving=document.getElementById('engravingInput').value;updatePrice();}
function updatePrice(){
  const base = priceMap[currentShape][currentSize]||500;
  const fAdd = finishAdd[currentFinish]||0;
  const eAdd = currentEngraving.length>0?100:0;
  document.getElementById('configPrice').textContent='₹'+(base+fAdd+eAdd);
}
function placeCustomOrder(){
  openModal(`🏺 Custom Order Placed!`,`Your ${currentSize} ${currentShape} in ${currentFinish} finish has been queued for crafting! We'll fire it, glaze it, and ship it to you in 7–10 days. Expect a WhatsApp confirmation soon!`);
}

window.addEventListener('load',()=>{
  setTimeout(initThree,500);
});

// ============ CATEGORY TABS ============
function showCategory(cat){
  document.querySelectorAll('.category-section').forEach(s=>s.classList.remove('active'));
  document.getElementById('cat-'+cat).classList.add('active');
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  event.target.classList.add('active');
}

// ============ CART ============
let cart=[];
function addToCart(name,price){
  cart.push({name,price});
  showToast(`🛒 ${name} added to cart!`);
}

// ============ RESERVATION ============
let selectedGroup = null;
function selectGroup(n,btn){
  selectedGroup=n;
  document.querySelectorAll('.gs-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
function submitReservation(){
  const name=document.getElementById('resName').value.trim();
  const email=document.getElementById('resEmail').value.trim();
  const date=document.getElementById('resDate').value;
  const time=document.getElementById('resTime').value;
  if(!name||!email||!date||!time||!selectedGroup){
    showToast('⚠️ Please fill all required fields & select group size!');return;
  }
  // 24hr check
  const chosen=new Date(date);
  const now=new Date();
  const diff=(chosen-now)/(1000*60*60);
  if(diff<24&&diff>=0){
    showToast('⏰ Please book at least 24 hours in advance!');return;
  }
  openModal('🎉 Booking Confirmed!',`Thank you, ${name}! Your table for ${selectedGroup} is reserved on ${date} at ${time}. A WhatsApp confirmation will be sent to your phone. We can't wait to see you at VakdetiKade Creations! 🏺☕`);
  // Reset
  document.getElementById('resName').value='';
  document.getElementById('resEmail').value='';
  document.getElementById('resDate').value='';
  document.getElementById('resTime').value='';
  document.getElementById('resNotes').value='';
  document.querySelectorAll('.gs-btn').forEach(b=>b.classList.remove('active'));
  selectedGroup=null;
}

// ============ TOAST ============
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3500);
}

// ============ MODAL ============
function openModal(title,text){
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalText').textContent=text;
  document.getElementById('modalOverlay').classList.add('open');
}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open');}

// ============ NAV ============
function toggleNav(){
  document.getElementById('navLinks').classList.toggle('open');
}

// ============ SCROLL REVEAL ============
const reveals=document.querySelectorAll('.reveal');
const observer=new IntersectionObserver((entries)=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');}});
},{threshold:0.1});
reveals.forEach(r=>observer.observe(r));

// ============ NAV SCROLL EFFECT ============
window.addEventListener('scroll',()=>{
  const nav=document.getElementById('mainNav');
  if(window.scrollY>80){nav.style.boxShadow='0 4px 30px rgba(0,0,0,0.5)';}
  else{nav.style.boxShadow='none';}
});

// Set min date for reservation (today)
window.addEventListener('load',()=>{
  const d=new Date();
  d.setDate(d.getDate()+1);
  const str=d.toISOString().split('T')[0];
  document.getElementById('resDate').setAttribute('min',str);
});
</script>
