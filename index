<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VakdetiKade Creations – Pottery Café, Hadapsar Pune</title>
<meta name="description" content="VakdetiKade Creations – A unique pottery café in Hadapsar, Pune. Handcrafted ceramics, artisan beverages, 3D customization and café experiences.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Nunito:wght@400;600;700&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">
<style>
  :root {
    --clay: #C1440E;
    --terracotta: #E8623A;
    --saffron: #F4A01C;
    --cream: #FFF8F0;
    --warm-white: #FFFDF9;
    --forest: #2D5016;
    --olive: #5C7A2A;
    --charcoal: #2C2218;
    --sand: #D4B896;
    --dusty-rose: #E8A87C;
    --deep-brown: #4A2C0A;
    --teal: #1A7A6E;
    --gold: #D4AF37;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Nunito',sans-serif;
    background:var(--warm-white);
    color:var(--charcoal);
    overflow-x:hidden;
  }

  /* ===== NAV ===== */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    background:rgba(44,34,24,0.95);
    backdrop-filter:blur(10px);
    display:flex;align-items:center;justify-content:space-between;
    padding:0 2rem;height:70px;
    border-bottom:2px solid var(--saffron);
  }
  .logo{
    font-family:'Dancing Script',cursive;
    font-size:1.8rem;color:var(--saffron);
    text-shadow:0 0 20px rgba(244,160,28,0.4);
  }
  .logo span{color:var(--terracotta);}
  .nav-links{display:flex;gap:1.5rem;list-style:none;}
  .nav-links a{
    color:#fff;text-decoration:none;
    font-weight:600;font-size:0.88rem;letter-spacing:0.05em;
    transition:color 0.3s;text-transform:uppercase;
  }
  .nav-links a:hover{color:var(--saffron);}
  .nav-cta{
    background:linear-gradient(135deg,var(--clay),var(--terracotta));
    color:#fff!important;padding:0.5rem 1.2rem;
    border-radius:25px;border:none;cursor:pointer;
    font-weight:700;font-size:0.85rem;
    box-shadow:0 4px 15px rgba(193,68,14,0.4);
    transition:transform 0.2s,box-shadow 0.2s;
    display:inline-block;text-decoration:none;
  }
  .nav-cta:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(193,68,14,0.6);}
  .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
  .hamburger span{width:25px;height:3px;background:#fff;border-radius:2px;transition:0.3s;}

  /* ===== HERO ===== */
  #hero{
    min-height:100vh;
    background: linear-gradient(135deg,#2C1A08 0%,#4A2C0A 40%,#8B4513 70%,#C1440E 100%);
    display:flex;align-items:center;justify-content:center;
    text-align:center;position:relative;overflow:hidden;
    padding:100px 2rem 4rem;
  }
  .hero-bg-art{
    position:absolute;inset:0;
    background-image:radial-gradient(ellipse at 20% 30%,rgba(244,160,28,0.15) 0%,transparent 50%),
      radial-gradient(ellipse at 80% 70%,rgba(232,98,58,0.15) 0%,transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  .floating-pots{position:absolute;inset:0;pointer-events:none;}
  .pot{
    position:absolute;font-size:3rem;opacity:0.08;
    animation:float 6s ease-in-out infinite;
  }
  .pot:nth-child(1){top:10%;left:5%;animation-delay:0s;}
  .pot:nth-child(2){top:20%;right:8%;animation-delay:1.5s;}
  .pot:nth-child(3){bottom:20%;left:10%;animation-delay:3s;}
  .pot:nth-child(4){bottom:15%;right:5%;animation-delay:4.5s;}
  .pot:nth-child(5){top:50%;left:2%;animation-delay:2s;}
  @keyframes float{0%,100%{transform:translateY(0) rotate(-5deg);}50%{transform:translateY(-20px) rotate(5deg);}}
  .hero-content{position:relative;z-index:2;max-width:800px;}
  .hero-badge{
    display:inline-block;
    background:rgba(244,160,28,0.2);
    border:1px solid var(--saffron);
    color:var(--saffron);
    padding:0.4rem 1.2rem;border-radius:20px;
    font-size:0.8rem;letter-spacing:0.15em;text-transform:uppercase;
    margin-bottom:1.5rem;font-weight:700;
  }
  .hero-title{
    font-family:'Playfair Display',serif;
    font-size:clamp(2.8rem,7vw,5.5rem);
    color:#fff;line-height:1.1;
    margin-bottom:0.5rem;
  }
  .hero-title .accent{color:var(--saffron);}
  .hero-subtitle{
    font-family:'Dancing Script',cursive;
    font-size:clamp(1.4rem,3.5vw,2.2rem);
    color:var(--dusty-rose);margin-bottom:1.5rem;
  }
  .hero-desc{
    color:rgba(255,255,255,0.75);
    font-size:1.05rem;line-height:1.7;
    max-width:550px;margin:0 auto 2.5rem;
  }
  .hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
  .btn-primary{
    background:linear-gradient(135deg,var(--saffron),var(--terracotta));
    color:#fff;padding:0.9rem 2.2rem;border-radius:35px;
    text-decoration:none;font-weight:700;font-size:1rem;
    box-shadow:0 8px 25px rgba(244,160,28,0.4);
    transition:transform 0.3s,box-shadow 0.3s;
    border:none;cursor:pointer;display:inline-block;
  }
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(244,160,28,0.6);}
  .btn-outline{
    border:2px solid rgba(255,255,255,0.5);
    color:#fff;padding:0.9rem 2.2rem;border-radius:35px;
    text-decoration:none;font-weight:700;font-size:1rem;
    transition:all 0.3s;display:inline-block;
    background:rgba(255,255,255,0.05);
  }
  .btn-outline:hover{background:rgba(255,255,255,0.15);border-color:#fff;}
  .hero-stats{
    display:flex;gap:3rem;justify-content:center;margin-top:3rem;
    flex-wrap:wrap;
  }
  .stat{text-align:center;}
  .stat-num{font-family:'Playfair Display',serif;font-size:2rem;color:var(--saffron);font-weight:900;}
  .stat-label{font-size:0.78rem;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.1em;}

  /* ===== SECTION BASE ===== */
  section{padding:5rem 2rem;}
  .container{max-width:1200px;margin:0 auto;}
  .section-badge{
    display:inline-block;
    background:linear-gradient(135deg,var(--saffron),var(--terracotta));
    color:#fff;padding:0.3rem 1rem;border-radius:15px;
    font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;
    margin-bottom:1rem;
  }
  .section-title{
    font-family:'Playfair Display',serif;
    font-size:clamp(2rem,4vw,3rem);
    color:var(--deep-brown);margin-bottom:1rem;
    line-height:1.2;
  }
  .section-sub{
    color:#6B5744;font-size:1.05rem;line-height:1.7;
    max-width:600px;margin:0 auto 3rem;
  }
  .text-center{text-align:center;}

  /* ===== ABOUT ===== */
  #about{background:var(--cream);}
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;}
  .about-img-stack{position:relative;height:420px;}
  .about-img-main{
    width:80%;height:100%;
    background:linear-gradient(135deg,var(--clay),var(--terracotta));
    border-radius:20px;overflow:hidden;
    box-shadow:0 20px 60px rgba(193,68,14,0.3);
    position:relative;
  }
  .about-img-main img{width:100%;height:100%;object-fit:cover;}
  .about-img-accent{
    position:absolute;bottom:-20px;right:0;
    width:50%;height:55%;
    background:linear-gradient(135deg,var(--saffron),var(--dusty-rose));
    border-radius:15px;
    border:4px solid var(--warm-white);
    box-shadow:0 10px 30px rgba(0,0,0,0.2);
    overflow:hidden;
  }
  .about-img-accent img{width:100%;height:100%;object-fit:cover;}
  .about-badge-float{
    position:absolute;top:20px;right:10px;
    background:var(--deep-brown);color:var(--saffron);
    padding:0.8rem 1.2rem;border-radius:12px;
    font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;
    box-shadow:0 8px 20px rgba(0,0,0,0.3);
    text-align:center;
  }
  .about-text h2{font-family:'Playfair Display',serif;font-size:2.5rem;color:var(--deep-brown);margin-bottom:1.2rem;}
  .about-text p{color:#5C4433;line-height:1.8;margin-bottom:1rem;font-size:1rem;}
  .about-features{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem;}
  .feat-chip{
    background:linear-gradient(135deg,rgba(244,160,28,0.15),rgba(232,98,58,0.15));
    border:1px solid rgba(244,160,28,0.4);
    padding:0.5rem 1rem;border-radius:20px;
    font-size:0.85rem;font-weight:700;color:var(--clay);
  }

  /* ===== CERAMICS SHOP ===== */
  #ceramics{background:var(--warm-white);}
  .category-tabs{
    display:flex;gap:0.8rem;justify-content:center;flex-wrap:wrap;margin-bottom:3rem;
  }
  .tab-btn{
    background:transparent;border:2px solid var(--sand);
    padding:0.6rem 1.5rem;border-radius:25px;cursor:pointer;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:0.9rem;
    color:#6B5744;transition:all 0.3s;
  }
  .tab-btn.active,.tab-btn:hover{
    background:linear-gradient(135deg,var(--clay),var(--terracotta));
    border-color:var(--clay);color:#fff;
    box-shadow:0 4px 15px rgba(193,68,14,0.3);
  }
  .products-grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:2rem;
  }
  .product-card{
    background:#fff;border-radius:20px;overflow:hidden;
    box-shadow:0 4px 20px rgba(0,0,0,0.08);
    transition:transform 0.3s,box-shadow 0.3s;
    position:relative;
  }
  .product-card:hover{transform:translateY(-8px);box-shadow:0 15px 40px rgba(193,68,14,0.2);}
  .product-img{
    height:220px;overflow:hidden;position:relative;
    background:linear-gradient(135deg,#f5e6d3,#e8c9a8);
  }
  .product-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}
  .product-card:hover .product-img img{transform:scale(1.08);}
  .product-badge{
    position:absolute;top:12px;left:12px;
    background:var(--saffron);color:var(--deep-brown);
    padding:0.25rem 0.7rem;border-radius:10px;
    font-size:0.72rem;font-weight:700;text-transform:uppercase;
  }
  .product-info{padding:1.2rem;}
  .product-name{font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--deep-brown);margin-bottom:0.3rem;}
  .product-desc{font-size:0.82rem;color:#7A6055;line-height:1.5;margin-bottom:0.8rem;}
  .product-footer{display:flex;align-items:center;justify-content:space-between;}
  .product-price{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--clay);}
  .product-price span{font-size:0.8rem;color:#9A8070;font-weight:400;font-family:'Nunito',sans-serif;}
  .add-cart{
    background:linear-gradient(135deg,var(--clay),var(--terracotta));
    color:#fff;border:none;padding:0.5rem 1.1rem;
    border-radius:20px;cursor:pointer;font-weight:700;
    font-size:0.82rem;transition:all 0.3s;
    font-family:'Nunito',sans-serif;
  }
  .add-cart:hover{transform:scale(1.05);box-shadow:0 4px 12px rgba(193,68,14,0.4);}
  .category-section{display:none;}
  .category-section.active{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:2rem;}

  /* ===== MENU / BEVERAGES ===== */
  #menu{background:linear-gradient(135deg,#2C1A08 0%,#4A2C0A 100%);position:relative;overflow:hidden;}
  #menu::before{
    content:'';position:absolute;inset:0;
    background:url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03' fill-rule='evenodd'%3E%3Ccircle cx='20' cy='20' r='15'/%3E%3C/g%3E%3C/svg%3E");
  }
  #menu .section-title{color:var(--saffron);}
  #menu .section-sub{color:rgba(255,255,255,0.65);}
  #menu .section-badge{background:linear-gradient(135deg,var(--saffron),var(--gold));}
  .menu-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;position:relative;z-index:2;}
  .menu-card{
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(244,160,28,0.2);
    border-radius:18px;overflow:hidden;
    transition:transform 0.3s,background 0.3s;
    backdrop-filter:blur(10px);
  }
  .menu-card:hover{transform:translateY(-5px);background:rgba(255,255,255,0.1);}
  .menu-card-img{height:180px;overflow:hidden;}
  .menu-card-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}
  .menu-card:hover .menu-card-img img{transform:scale(1.1);}
  .menu-card-body{padding:1.2rem;}
  .menu-cat{font-size:0.7rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--saffron);font-weight:700;margin-bottom:0.3rem;}
  .menu-name{font-family:'Playfair Display',serif;font-size:1.1rem;color:#fff;margin-bottom:0.4rem;}
  .menu-desc{font-size:0.8rem;color:rgba(255,255,255,0.6);line-height:1.5;margin-bottom:0.8rem;}
  .menu-price-row{display:flex;align-items:center;justify-content:space-between;}
  .menu-price{font-family:'Playfair Display',serif;font-size:1.25rem;color:var(--saffron);font-weight:700;}
  .menu-tag{
    background:rgba(244,160,28,0.15);
    border:1px solid rgba(244,160,28,0.3);
    color:var(--saffron);padding:0.2rem 0.6rem;
    border-radius:10px;font-size:0.72rem;font-weight:700;
  }

  /* ===== 3D CONFIGURATOR ===== */
  #configurator{background:var(--cream);}
  .configurator-wrapper{
    background:linear-gradient(135deg,#1a0f06,#2C1A08);
    border-radius:25px;overflow:hidden;
    box-shadow:0 30px 80px rgba(0,0,0,0.4);
    position:relative;
  }
  .configurator-header{
    padding:2rem 2.5rem;
    border-bottom:1px solid rgba(244,160,28,0.2);
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;
  }
  .configurator-header h3{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--saffron);}
  .configurator-header p{color:rgba(255,255,255,0.5);font-size:0.85rem;}
  .config-body{display:grid;grid-template-columns:1fr 340px;min-height:520px;}
  .canvas-area{
    display:flex;align-items:center;justify-content:center;
    position:relative;background:linear-gradient(135deg,#0e0704,#1a0f06);
    padding:2rem;
  }
  .canvas-3d{
    width:100%;max-width:450px;aspect-ratio:1;
    position:relative;
  }
  #potCanvas{width:100%!important;height:100%!important;border-radius:15px;}
  .canvas-hint{
    position:absolute;bottom:15px;left:50%;transform:translateX(-50%);
    background:rgba(0,0,0,0.5);color:rgba(255,255,255,0.6);
    padding:0.4rem 1rem;border-radius:10px;font-size:0.75rem;
    white-space:nowrap;
  }
  .config-panel{
    background:rgba(255,255,255,0.04);
    border-left:1px solid rgba(244,160,28,0.15);
    padding:2rem;overflow-y:auto;
  }
  .config-section{margin-bottom:1.8rem;}
  .config-label{
    font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;
    color:rgba(255,255,255,0.5);font-weight:700;margin-bottom:0.8rem;
    display:block;
  }
  .config-options{display:flex;gap:0.6rem;flex-wrap:wrap;}
  .opt-btn{
    background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);
    color:rgba(255,255,255,0.7);padding:0.45rem 0.9rem;
    border-radius:10px;cursor:pointer;font-size:0.82rem;
    font-family:'Nunito',sans-serif;font-weight:600;
    transition:all 0.25s;
  }
  .opt-btn.active,.opt-btn:hover{
    background:linear-gradient(135deg,rgba(193,68,14,0.4),rgba(232,98,58,0.3));
    border-color:var(--terracotta);color:#fff;
  }
  .color-swatches{display:flex;gap:0.6rem;flex-wrap:wrap;}
  .swatch{
    width:34px;height:34px;border-radius:50%;cursor:pointer;
    border:3px solid transparent;transition:transform 0.2s,border-color 0.2s;
  }
  .swatch.active,.swatch:hover{transform:scale(1.2);border-color:#fff;}
  .config-slider input{width:100%;accent-color:var(--terracotta);}
  .config-slider{margin-top:0.5rem;}
  .slider-labels{display:flex;justify-content:space-between;font-size:0.72rem;color:rgba(255,255,255,0.4);margin-top:0.4rem;}
  .engraving-input{
    width:100%;background:rgba(255,255,255,0.06);
    border:1px solid rgba(244,160,28,0.2);
    color:#fff;padding:0.7rem 1rem;border-radius:10px;
    font-family:'Nunito',sans-serif;font-size:0.9rem;
    outline:none;
  }
  .engraving-input:focus{border-color:var(--saffron);}
  .engraving-input::placeholder{color:rgba(255,255,255,0.3);}
  .config-total{
    background:linear-gradient(135deg,rgba(244,160,28,0.1),rgba(193,68,14,0.1));
    border:1px solid rgba(244,160,28,0.3);
    border-radius:12px;padding:1rem;margin-bottom:1.2rem;
    text-align:center;
  }
  .config-total-label{font-size:0.72rem;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.1em;}
  .config-total-price{font-family:'Playfair Display',serif;font-size:2rem;color:var(--saffron);}
  .config-order-btn{
    width:100%;
    background:linear-gradient(135deg,var(--clay),var(--terracotta));
    color:#fff;border:none;padding:1rem;border-radius:12px;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:1rem;
    cursor:pointer;transition:all 0.3s;
    box-shadow:0 6px 20px rgba(193,68,14,0.4);
  }
  .config-order-btn:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(193,68,14,0.6);}

  /* ===== RESERVATION ===== */
  #reservation{background:linear-gradient(135deg,var(--teal) 0%,#0d5449 100%);position:relative;overflow:hidden;}
  #reservation::before{
    content:'';position:absolute;inset:0;
    background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='25'/%3E%3C/g%3E%3C/svg%3E");
  }
  #reservation .section-title{color:#fff;}
  #reservation .section-sub{color:rgba(255,255,255,0.65);}
  #reservation .section-badge{background:linear-gradient(135deg,#4CAF50,var(--teal));}
  .reservation-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;position:relative;z-index:2;}
  .reservation-info h3{font-family:'Playfair Display',serif;font-size:1.5rem;color:#fff;margin-bottom:1rem;}
  .reservation-info p{color:rgba(255,255,255,0.7);line-height:1.7;margin-bottom:1.5rem;}
  .res-rules{list-style:none;}
  .res-rules li{
    display:flex;align-items:flex-start;gap:0.7rem;
    color:rgba(255,255,255,0.75);padding:0.7rem 0;
    border-bottom:1px solid rgba(255,255,255,0.1);font-size:0.9rem;
  }
  .res-rules li .icon{font-size:1.2rem;flex-shrink:0;margin-top:0.05rem;}
  .res-form{
    background:rgba(255,255,255,0.1);backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:20px;padding:2.5rem;
  }
  .res-form h3{font-family:'Playfair Display',serif;font-size:1.4rem;color:#fff;margin-bottom:1.5rem;}
  .form-group{margin-bottom:1.2rem;}
  .form-group label{
    display:block;font-size:0.8rem;font-weight:700;
    color:rgba(255,255,255,0.7);margin-bottom:0.4rem;
    text-transform:uppercase;letter-spacing:0.08em;
  }
  .form-group input,.form-group select,.form-group textarea{
    width:100%;padding:0.8rem 1rem;border-radius:10px;
    background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);
    color:#fff;font-family:'Nunito',sans-serif;font-size:0.95rem;
    outline:none;transition:border-color 0.3s;
    -webkit-appearance:none;
  }
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{
